+uint16_t Comm_Crc16(const uint8_t *data, uint16_t len)
+{
+    uint16_t crc = 0xFFFFU;
+    for (uint16_t i = 0U; i < len; i++) {
+        crc ^= (uint16_t)((uint16_t)data[i] << 8);
+        for (uint8_t b = 0U; b < 8U; b++) {
+            crc = ((crc & 0x8000U) != 0U) ? (uint16_t)((crc << 1) ^ 0x1021U) : (uint16_t)(crc << 1);
+        }
+    }
+    return crc;
+}
+
+void Comm_PackFrameV2(uint8_t out[COMM_FRAME_V2_SIZE], uint8_t seq, const comm_telemetry_v2_t *t)
+{
+    out[0] = COMM_FRAME_HEADER0;
+    out[1] = COMM_FRAME_V2_HEADER1;
+    out[2] = seq;
+    out[3] = t->status;
+    for (uint8_t i = 0U; i < 4U; i++) { put_u16le(&out[4U + 2U * i], (uint16_t)t->q[i]); }
+    for (uint8_t i = 0U; i < 3U; i++) { put_u16le(&out[12U + 2U * i], (uint16_t)t->gyro_mrads[i]); }
+    for (uint8_t i = 0U; i < 3U; i++) { put_u16le(&out[18U + 2U * i], (uint16_t)t->accel_4096[i]); }
+    put_u16le(&out[24], t->t_us);
+    put_u16le(&out[26], Comm_Crc16(out, 26U));
+}
