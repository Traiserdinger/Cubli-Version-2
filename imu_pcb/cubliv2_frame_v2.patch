+/**
+ * ===========================================================================
+ * 6. FRAME V2 (CubliV2, bật bằng lệnh "CUBLI", tắt bằng "FRAME1")
+ * ===========================================================================
+ *   Byte   Trường        Kiểu       Ý nghĩa
+ *    0     HEADER0       0xAA
+ *    1     HEADER1       0x56
+ *    2     SEQ           uint8
+ *    3     STATUS        uint8      bit0 EKF sẵn sàng, bit1 IMU1, bit2 IMU2,
+ *                                   bit3 gia tốc bị loại, bit4 dùng từ kế,
+ *                                   bit5 lấy mẫu theo chân INT
+ *   4-11   Q0..Q3        int16      quaternion body->world, x 32767
+ *  12-17   GX,GY,GZ      int16      gyro đã trừ bias, đơn vị 1 mrad/s
+ *  18-23   AX,AY,AZ      int16      gia tốc, đơn vị 1/4096 g
+ *  24-25   T_US          uint16     thời điểm lấy mẫu (µs, tràn vòng)
+ *  26-27   CRC16         uint16     CRC-16/CCITT-FALSE (0x1021, init 0xFFFF)
+ *                                   của byte 0..25, byte thấp trước
+ *   "CUBLI": chuyển sang v2 và CFG_UART_CUBLI_BAUD sau frame đang gửi + 20 ms.
+ *   "FRAME1": quay lại v1 và CFG_UART_DEFAULT_BAUD.
+ *   "REINIT": khởi tạo lại EKF (mạch phải đứng yên) -> học lại bias gyro.
+ */
+typedef enum {
+    COMM_FRAME_MODE_V1 = 1,
+    COMM_FRAME_MODE_V2 = 2
+} comm_frame_mode_t;
+
+typedef struct {
+    uint8_t  status;
+    int16_t  q[4];
+    int16_t  gyro_mrads[3];
+    int16_t  accel_4096[3];
+    uint16_t t_us;
+} comm_telemetry_v2_t;
+
+#define COMM_V2_STATUS_EKF_READY   0x01U
+#define COMM_V2_STATUS_IMU1_OK     0x02U
+#define COMM_V2_STATUS_IMU2_OK     0x04U
+#define COMM_V2_STATUS_ACC_REJECT  0x08U
+#define COMM_V2_STATUS_MAG_FUSED   0x10U
+#define COMM_V2_STATUS_DRDY_CLOCK  0x20U
+
